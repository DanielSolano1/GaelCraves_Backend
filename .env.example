# GaelCraves Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration (Heroku provides DATABASE_URL automatically)
DATABASE_URL=jdbc:postgresql://localhost:5432/gaelcraves
DB_USER=postgres
DB_PASS=your_password_here

# JWT Configuration (REQUIRED - generate a secure base64 encoded secret)
APP_JWT_SECRET=your-base64-encoded-secret-key-here-minimum-256-bits
JWT_EXPIRATION=86400000

# CORS Configuration (comma-separated for multiple origins)
FRONTEND_ORIGIN=http://localhost:8081,https://your-frontend-url.herokuapp.com

# Google OAuth (REQUIRED for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Supabase (Optional - only if using Supabase features)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# Database Pool Settings (Heroku optimized)
DB_POOL_SIZE=5
DB_MIN_IDLE=2
JPA_DDL_AUTO=update

# Server Port (Heroku sets this automatically)
PORT=8080